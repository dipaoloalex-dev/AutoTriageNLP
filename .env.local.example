# ========================================
# VARIABILI D'AMBIENTE FRONTEND (Next.js)
# ========================================
# Questo file è un template di esempio (.env.local.example)
# Per usarlo, copialo e rinominalo in: .env.local
# Il file .env.local NON viene versionato su Git (vedi .gitignore)

# ----------------------------------------
# NEXT_PUBLIC_API_URL
# ----------------------------------------
# URL di base del backend API a cui il frontend deve inviare le richieste
#
# NOTA BENE: In Next.js, le variabili che iniziano con "NEXT_PUBLIC_"
# sono esposte lato client (visibili nel browser) e sono quindi sicure
# da usare per URL pubblici del backend.
#
# Valori comuni:
# - Sviluppo locale:  http://localhost:8000
# - Container Docker: http://backend:8000 (se comunicano via rete interna)
# - Produzione:      https://api.miodominio.com
#
# Il frontend userà questo valore per costruire le chiamate API es:
# fetch(`${NEXT_PUBLIC_API_URL}/api/v1/health`)
NEXT_PUBLIC_API_URL=http://localhost:8000
