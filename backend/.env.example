# AutoTriage NLP Backend - Environment Variables

APP_NAME=AutoTriage NLP API
APP_VERSION=2.0.0
API_PREFIX=/api/v1

# Model Configuration
MODEL_PATH=../models/unified_model.pkl

# CORS Settings (comma-separated list)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# API Settings
MAX_BATCH_SIZE=1000
MAX_TEXT_LENGTH=10000

# Logging
LOG_LEVEL=info
